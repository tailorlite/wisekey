{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "types": ["node"]
    },
    "include": ["src/**/*", "examples/**/*", "cli.ts"],
    "exclude": ["tests/**/*", "node_modules", "dist"]
}
